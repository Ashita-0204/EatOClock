{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://eatoclock.onrender.com",
      "https://eatoclockfrontend.onrender.com"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "auth-legacy-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/auth/{**remainder}" }
        ]
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/v1/cart/{**catch-all}" }
      },
      "cart-legacy-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/cart/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/cart/{**remainder}" }
        ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" }
      },
      "orders-legacy-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/api/orders/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/orders/{**remainder}" }
        ]
      },
      "payments-route": {
        "ClusterId": "payments-cluster",
        "Match": { "Path": "/api/v1/payments/{**catch-all}" }
      },
      "payments-legacy-route": {
        "ClusterId": "payments-cluster",
        "Match": { "Path": "/api/payments/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/payments/{**remainder}" }
        ]
      },
      "wallet-route": {
        "ClusterId": "payments-cluster",
        "Match": { "Path": "/api/v1/wallet/{**catch-all}" }
      },
      "wallet-legacy-route": {
        "ClusterId": "payments-cluster",
        "Match": { "Path": "/api/wallet/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/wallet/{**remainder}" }
        ]
      },
      "agents-route": {
        "ClusterId": "delivery-cluster",
        "Match": { "Path": "/api/v1/agents/{**catch-all}" }
      },
      "agents-legacy-route": {
        "ClusterId": "delivery-cluster",
        "Match": { "Path": "/api/agents/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/agents/{**remainder}" }
        ]
      },
      "location-hub-route": {
        "ClusterId": "delivery-cluster",
        "Match": { "Path": "/hubs/location/{**catch-all}" }
      },
      "restaurants-route": {
        "ClusterId": "restaurant-cluster",
        "Match": { "Path": "/api/v1/restaurant/{**catch-all}" }
      },
      "restaurants-legacy-route": {
        "ClusterId": "restaurant-cluster",
        "Match": { "Path": "/api/restaurant/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/restaurant/{**remainder}" }
        ]
      },
      "menu-route": {
        "ClusterId": "menu-cluster",
        "Match": { "Path": "/api/v1/menu/{**catch-all}" }
      },
      "menu-legacy-route": {
        "ClusterId": "menu-cluster",
        "Match": { "Path": "/api/menu/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/menu/{**remainder}" }
        ]
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Match": { "Path": "/api/v1/reviews/{**catch-all}" }
      },
      "reviews-legacy-route": {
        "ClusterId": "reviews-cluster",
        "Match": { "Path": "/api/reviews/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/reviews/{**remainder}" }
        ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" }
      },
      "notifications-legacy-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/api/notifications/{**remainder}" },
        "Transforms": [
          { "PathPattern": "/api/v1/notifications/{**remainder}" }
        ]
      },
      "notifications-hub-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/hubs/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "HttpClient": {
          "HttpRequestTimeout": "00:03:00"
        },
        "Destinations": {
          "auth": { "Address": "https://eatoclock.onrender.com" }
        }
      },
      "cart-cluster": {
        "HttpClient": {
          "HttpRequestTimeout": "00:03:00"
        },
        "Destinations": {
          "cart": { "Address": "https://eatoclock-cart.onrender.com" }
        }
      },
      "orders-cluster": {
        "HttpClient": {
          "HttpRequestTimeout": "00:03:00"
        },
        "Destinations": {
          "orders": { "Address": "https://eatoclock-order.onrender.com" }
        }
      },
      "payments-cluster": {
        "HttpClient": {
          "HttpRequestTimeout": "00:03:00"
        },
        "Destinations": {
          "payments": { "Address": "https://eatoclock-payment.onrender.com" }
        }
      },
      "delivery-cluster": {
        "HttpClient": {
          "HttpRequestTimeout": "00:03:00"
        },
        "Destinations": {
          "delivery": { "Address": "https://eatoclock-delivery.onrender.com" }
        }
      },
      "restaurant-cluster": {
        "HttpClient": {
          "HttpRequestTimeout": "00:03:00"
        },
        "Destinations": {
          "restaurant": { "Address": "https://eatoclock-restaurant.onrender.com" }
        }
      },
      "menu-cluster": {
        "HttpClient": {
          "HttpRequestTimeout": "00:03:00"
        },
        "Destinations": {
          "menu": { "Address": "https://eatoclock-menu.onrender.com" }
        }
      },
      "reviews-cluster": {
        "HttpClient": {
          "HttpRequestTimeout": "00:03:00"
        },
        "Destinations": {
          "reviews": { "Address": "https://eatoclock-review.onrender.com" }
        }
      },
      "notifications-cluster": {
        "HttpClient": {
          "HttpRequestTimeout": "00:03:00"
        },
        "Destinations": {
          "notifications": { "Address": "https://eatoclock-notif.onrender.com" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}