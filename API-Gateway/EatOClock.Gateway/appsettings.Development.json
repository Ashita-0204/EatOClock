{
  "ASPNETCORE_ENVIRONMENT": "Development",
  "Services": {
    "Auth":          "http://localhost:5001",
    "Restaurant":    "http://localhost:5002",
    "Menu":          "http://localhost:5003",
    "Cart":          "http://localhost:5004",
    "Order":         "http://localhost:5005",
    "Payment":       "http://localhost:5006",
    "Notification":  "http://localhost:5009",
    "DeliveryAgent": "http://localhost:5007",
    "Review":        "http://localhost:5008"
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster":          { "Destinations": { "auth-service":          { "Address": "http://localhost:5001" } } },
      "restaurant-cluster":    { "Destinations": { "restaurant-service":    { "Address": "http://localhost:5002" } } },
      "menu-cluster":          { "Destinations": { "menu-service":          { "Address": "http://localhost:5003" } } },
      "cart-cluster":          { "Destinations": { "cart-service":          { "Address": "http://localhost:5004" } } },
      "order-cluster":         { "Destinations": { "order-service":         { "Address": "http://localhost:5005" } } },
      "payment-cluster":       { "Destinations": { "payment-service":       { "Address": "http://localhost:5006" } } },
      "notification-cluster":  { "Destinations": { "notification-service":  { "Address": "http://localhost:5009" } } },
      "delivery-agent-cluster":{ "Destinations": { "delivery-agent-service":{ "Address": "http://localhost:5007" } } },
      "review-cluster":        { "Destinations": { "review-service":        { "Address": "http://localhost:5008" } } }
    }
  }
}
